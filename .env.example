# Front-end configuration. Copy to .env — scripts/bootstrap.sh does this for you
# and fills in the key automatically.
#
# IMPORTANT: these are compiled INTO the JavaScript by `npm run build`. They are
# not read when the server runs. Change either one and you must rebuild, or
# nothing happens. Use scripts/set-public-url.sh, which rebuilds for you.

# The address visitors' browsers use. Both the pages and the API live here —
# Caddy splits them. Must be the public tunnel address once you go live;
# localhost only works on the Mac itself.
VITE_SUPABASE_URL=http://localhost:8080

# The local stack's anon key, printed by `supabase start`.
# Public by design: row-level security is what protects the data, not this key.
# Get it any time with:  supabase status -o env
VITE_SUPABASE_ANON_KEY=
