# Supabase stack configuration, read by config.toml at startup.
# Copy to supabase/.env — scripts/bootstrap.sh does this for you.
#
# Unlike the front-end .env, these ARE read at runtime. Changing them needs a
# `supabase stop && supabase start`, not a rebuild.

# The public address of the site. GoTrue builds OAuth redirects and the
# visitor magic-links from this, so it must match what browsers actually use.
FRC_SITE_URL=http://localhost:8080

# Google sign-in. Optional — leave blank and the site runs on email/password
# plus visitor tickets. To switch it on, fill these in, set enabled = true
# under [auth.external.google] in config.toml, and add
#   <FRC_SITE_URL>/auth/v1/callback
# to the authorised redirect URIs of your Google Cloud OAuth client.
FRC_GOOGLE_CLIENT_ID=
FRC_GOOGLE_SECRET=
